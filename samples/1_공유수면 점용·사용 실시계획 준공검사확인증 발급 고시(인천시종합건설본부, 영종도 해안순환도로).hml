an="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="11222" Protect="false" RowAddr="1" RowSpan="1" Width="47907"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="17" Style="0"><TEXT CharShape="2"/></P><P ParaShape="19" Style="0"><TEXT CharShape="17"><CHAR>공유수면 점용·사용 실시계획 준공검사확인증 발급 고시</CHAR></TEXT></P><P ParaShape="19" Style="0"><TEXT CharShape="17"/></P><P ParaShape="20" Style="0"><TEXT CharShape="18"><CHAR> </CHAR></TEXT><TEXT CharShape="19"><CHAR> </CHAR></TEXT><TEXT CharShape="20"><CHAR>「공유수면 관리 및 매립에 관한 법률」제18조에 따라 </CHAR></TEXT><TEXT CharShape="21"><CHAR>“영종해안순환도로 개설공사 중 가물막이 공사”</CHAR></TEXT><TEXT CharShape="20"><CHAR>에 대하여 실시계획 준공검사를 실시, 같은 법 제18조제5항에 따라 준공검사확인증을 발급하고 같은 법 제18조제6항에 따라 다음과 같이 고시합니다. </CHAR></TEXT></P><P ParaShape="18" Style="0"><TEXT CharShape="16"/></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="3" ColAddr="0" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="0" Name="11111" Protect="false" RowAddr="2" RowSpan="1" Width="47907"><CELLMARGIN Bottom="802" Left="0" Right="802" Top="0"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="18" Style="0"><TEXT CharShape="16"><CHAR>2026년 07월 06일</CHAR></TEXT></P><P ParaShape="18" Style="0"><TEXT CharShape="16"><CHAR>인천지방해양수산청장</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="22" Style="0"><TEXT CharShape="1"><CHAR> </CHAR></TEXT><TEXT CharShape="23"><CHAR>1. 공사명칭 </CHAR></TEXT><TEXT CharShape="24"><CHAR>: ｢영종해안순환도로 일부구간 가물막이설치｣</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="25"/></P><P ParaShape="24" Style="0"><TEXT CharShape="23"><CHAR> 2. 공사 시행자의 성명(또는 명칭 및 주소)</CHAR></TEXT><TEXT CharShape="26"/></P><P ParaShape="25" Style="0"><TEXT CharShape="27"/></P><P ParaShape="24" Style="0"><TEXT CharShape="24"><CHAR>  가. </CHAR></TEXT><TEXT CharShape="28"><CHAR>성  명 : 인천광역시 종합건설본부</CHAR></TEXT><TEXT CharShape="26"/></P><P ParaShape="25" Style="0"><TEXT CharShape="27"/></P><P ParaShape="24" Style="0"><TEXT CharShape="24"><CHAR>  나. </CHAR></TEXT><TEXT CharShape="28"><CHAR>주  소 : 인천광역시 미추홀구 한나루로 607</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="25"/></P><P ParaShape="24" Style="0"><TEXT CharShape="23"><CHAR> 3. 공사의 종류</CHAR></TEXT><TEXT CharShape="24"><CHAR> : 토목</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="25"/></P><P ParaShape="24" Style="0"><TEXT CharShape="23"><CHAR> 4. 공사의 목적 및 개요</CHAR></TEXT></P><P ParaShape="25" Style="0"><TEXT CharShape="27"/></P><P ParaShape="26" Style="0"><TEXT CharShape="24"><CHAR>  가. 목  적 : </CHAR></TEXT><TEXT CharShape="29"><CHAR>영종해안순환도로 개설공사 중 기존 </CHAR></TEXT><TEXT CharShape="30"><CHAR>배수문 철거를 위해 해측 토사 및</CHAR></TEXT><TEXT CharShape="31"><CHAR> 오염물질 방류 방지를 위하여 해측에 가물막이(토공+마대+차수시트) 공사시행 </CHAR></TEXT></P><P ParaShape="25" Style="0"><TEXT CharShape="32"/></P><P ParaShape="27" Style="0"><TEXT CharShape="24"><CHAR>  나. 공사개요</CHAR></TEXT><TEXT CharShape="26"/></P><P ParaShape="25" Style="0"><TEXT CharShape="27"/></P><P ParaShape="27" Style="0"><TEXT CharShape="33"><CHAR> </CHAR></TEXT><TEXT CharShape="28"><CHAR>  - 위  치 : 인천광역시 중구 </CHAR></TEXT><TEXT CharShape="31"><CHAR>중산동 1849-3 인근 공유수면</CHAR></TEXT></P><P ParaShape="25" Style="0"><TEXT CharShape="27"/></P><P ParaShape="27" Style="0"><TEXT CharShape="33"><CHAR> </CHAR></TEXT><TEXT CharShape="28"><CHAR>  - 사업비 : 198백만원</CHAR></TEXT><TEXT CharShape="26"/></P><P ParaShape="25" Style="0"><TEXT CharShape="27"/></P><P ParaShape="27" Style="0"><TEXT CharShape="33"><CHAR> </CHAR></TEXT><TEXT CharShape="28"><CHAR>  - 사업내용 : </CHAR></TEXT><TEXT CharShape="24"><CHAR>가물막이(L=59m,B=4.50m,H=4.50m), 오탁방지막 설치 1식</CHAR></TEXT></P><P ParaShape="27" Style="0"><TEXT CharShape="25"/></P><P ParaShape="28" Style="0"><TEXT CharShape="23"><CHAR> 5. 점용·사용 허가일</CHAR></TEXT><TEXT CharShape="24"><CHAR> : 2025. 02. 25.</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="25"/></P><P ParaShape="24" Style="0"><TEXT CharShape="23"><CHAR> 6. 공사시행기간</CHAR></TEXT><TEXT CharShape="24"><CHAR> : ’25.<FWSPACE/>2.25.～ ’26.6.<FWSPACE/>30.</CHAR></TEXT></P><P ParaShape="24" Style="0"><TEXT CharShape="25"/></P><P ParaShape="29" Style="0"><TEXT CharShape="31"><CHAR> </CHAR></TEXT><TEXT CharShape="34"><CHAR>7. 준공 시설</CHAR></TEXT><TEXT CharShape="31"><CHAR> : 가물막이 및 오탁방지막 설치 및 철거</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="22"/></P><P ParaShape="17" Style="0"/></SECTION></BODY><TAIL><SCRIPTCODE Type="JScript" Version="1.0"><SCRIPTHEADER></SCRIPTHEADER><SCRIPTSOURCE></SCRIPTSOURCE></SCRIPTCODE></TAIL></HWPML>