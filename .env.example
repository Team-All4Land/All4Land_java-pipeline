# 리눅스 서버 배포용 환경변수 예시 — 이 파일을 .env로 복사해 값을 채우세요.
#   cp .env.example .env
#
# .env는 커밋 대상이 아니며(.gitignore의 *.env), 실행 디렉터리에서 자동으로 읽습니다.
# 다른 위치의 파일을 쓰려면 APP_ENV_FILE 환경변수로 경로를 지정하세요.
#
# 로드 우선순위: OS 환경변수 > .env > application.properties > 기본값

# --- PostgreSQL 접속 ---
DB_URL=jdbc:postgresql://localhost:5432/extract
DB_USER=extract
# 비밀번호는 여기(또는 OS 환경변수 PGPASSWORD/DB_PASSWORD)로만 주입하고 소스에 두지 마세요.
DB_PASSWORD=
DB_POOL_MAX_SIZE=5

# --- OCR (PaddleOCR-VL CLI) ---
# 가상환경을 쓰면 venv의 python 절대경로를 지정하세요. (예: /opt/ocr/.venv/bin/python)
OCR_CLI_COMMAND=python3
OCR_CLI_SCRIPT=ocr-cli/paddleocr_vl_cli.py
OCR_CLI_TIMEOUT_SEC=300

# --- 매핑 ---
# 본문이 이 글자 수를 넘으면 안내문류로 보고 DB 적재만 건너뜁니다(추출·매핑은 그대로 수행).
# 실측 기준값이며 코퍼스에 맞춰 조정하세요(README "적재 임계치 보정"). 0이면 제한 없음.
MAP_MAX_BODY_CHARS=5000
