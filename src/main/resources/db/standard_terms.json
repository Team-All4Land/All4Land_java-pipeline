    { "logical": "크롤종류코드",     "physical": "CRWL_KND_CD",       "domain": "D_CD",   "code": "CD_CRWL_KND", "description": "이 행을 만들어 낸 크롤러의 갈래. 전수 수집분과 일일 증분분을 갈라 세는 축이다" },
    { "logical": "담당부서명",       "physical": "CHRG_DEPT_NM",      "domain": "D_NM",   "description": "게시판이 표기한 담당부서" },
