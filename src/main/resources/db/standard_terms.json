    { "id": "D_CD",    "term": "코드",     "sqlType": "VARCHAR(25)",    "description": "표준코드 허용값. 공고종류·공고항목은 12자 규칙을 지키므로 폭을 정하는 것은 실패종류코드다 — 최장값이 DISTRIBUTION_UNSUPPORTED(24자)라 25로 잡았다" },
    { "id": "D_NM",    "term": "명",       "sqlType": "VARCHAR(300)",   "description": "이름. 첨부파일명이 공고 제목을 그대로 쓰는 경우가 있어 300으로 잡았다" },
    { "id": "D_TTL",   "term": "제목",     "sqlType": "VARCHAR(500)",   "description": "문서 제목. 고시문 제목은 한 문장을 통째로 쓰는 일이 잦아 명보다 길게 잡는다" },
    { "id": "D_DT",    "term": "일자",     "sqlType": "DATE",           "description": "날짜만. 시각이 필요하면 일시(DTM)를 쓴다" },
    { "id": "D_DTM",   "term": "일시",     "sqlType": "TIMESTAMPTZ",    "description": "타임존 포함 일시. 감사 컬럼이 이 도메인이다" },
    { "id": "D_YN",    "term": "여부",     "sqlType": "CHAR(1)",        "check": "VALUE IN ('Y','N')", "description": "'Y'/'N' 두 값만 허용한다. BOOLEAN을 쓰지 않는 이유는 표준 분류어 YN이 지시하는 도메인이 CHAR(1)이고, 도메인이 지시하는 타입과 실제 타입이 어긋나면 사전이 무의미해지기 때문이다" },
    { "id": "D_CTNT",  "term": "내용",     "sqlType": "TEXT",           "description": "길이를 예측할 수 없는 자유 텍스트. 실패 메시지·적재제외 사유·항목값이 여기 속한다" },
    { "id": "D_PATH",  "term": "경로",     "sqlType": "VARCHAR(1000)",  "description": "파일 시스템 절대경로" },
    { "id": "D_CNT",   "term": "건수",     "sqlType": "INTEGER",        "description": "예비 — 현재 스키마에 쓰이는 컬럼이 없다" },
    { "id": "D_DSCR",  "term": "설명",     "sqlType": "VARCHAR(1000)",  "description": "예비. 주의: 물리명을 DESC로 줄이면 SQL 예약어와 충돌한다" },
    { "id": "D_AMT",   "term": "금액",     "sqlType": "NUMERIC(18,3)",  "description": "예비" },
    { "id": "D_QTY",   "term": "수량",     "sqlType": "NUMERIC",        "description": "예비" },
    { "id": "D_RT",    "term": "율",       "sqlType": "NUMERIC(7,4)",   "description": "예비" },
    { "id": "D_SEQ",   "term": "순번",     "sqlType": "INTEGER",        "description": "예비 — 이 스키마의 순번은 전부 일련번호(SN)로 등록돼 있다" },
    { "id": "D_SE",    "term": "구분",     "sqlType": "VARCHAR(4)",     "description": "예비 — 코드 테이블 없이 두세 값만 가르는 구분값용" },
    { "id": "D_ID",    "term": "식별자",   "sqlType": "VARCHAR(20)",    "description": "예비 — 사용자·시스템 식별자용" },
    { "id": "D_HASH",  "term": "해시",     "sqlType": "CHAR(64)",       "check": "VALUE ~ '^[0-9a-f]{64}$'", "description": "SHA-256 16진 표기 64자. CHAR(64)만으로는 부족해 CHECK을 건다 — character(n)은 짧은 값을 거부하지 않고 공백으로 채워 넣으므로 잘린 해시가 조용히 들어온다. 소문자만 받는 것도 일부러다: 같은 해시가 대소문자 두 벌로 저장되면 UNIQUE가 중복을 못 잡는다" },
    { "id": "D_URL",   "term": "URL",      "sqlType": "VARCHAR(2000)",  "description": "웹 주소. 경로(D_PATH, VARCHAR(1000))는 파일 시스템 절대경로 전용이라 쓸 수 없다 — URL은 질의문자열·앵커가 붙어 더 길고, 크롤러가 이미 2000으로 잡고 있다" }
  ],

