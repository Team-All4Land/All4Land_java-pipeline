  "terms": [
    { "logical": "기관일련번호",     "physical": "AGNCY_SN",          "domain": "D_SN",   "description": "크롤러가 발급한 기관번호가 정의처다. 크롤 산출물이 아닌 파일은 입력 폴더명 앞 번호로 AgencyRegistry가 폴더 집합 전체를 보고 결정론적으로 발급한다" },
    { "logical": "기관명",           "physical": "AGNCY_NM",          "domain": "D_NM",   "description": "수집처 기관명. 크롤러 엑셀에서 오고, 크롤 산출물이 아니면 입력 폴더명에서 온다. 크롤로그에도 담는 이유는 기관 행이 아예 없을 수 있어서다" },
    { "logical": "기관종류코드",     "physical": "AGNCY_KND_CD",      "domain": "D_CD",   "code": "CD_AGNCY_KND", "description": "GZT는 기관 종류가 아니라 수집 경로다 — 같은 부처를 자체 게시판과 전자관보 양쪽에서 긁으므로 이름이 같은 두 행을 이 값으로 가린다" },
    { "logical": "고시공고일련번호", "physical": "NOTI_SN",           "domain": "D_SN",   "description": "크롤 일련번호 = 크롤러 게시물 목록 엑셀의 번호이며 첨부파일명 앞자리다. 실행마다 1로 되돌아가지 않고 마지막 번호 뒤로 이어진다. 문서 본문의 고시번호(NOTI_NO)와는 다른 것이다" },
    { "logical": "게시상태코드",     "physical": "BBS_STTS_CD",       "domain": "D_CD",   "code": "CD_BBS_STTS", "description": "엑셀 검증요약의 기관명 꼬리표(목포시청_지난자료)로 가른다. 같은 기관이 게시판을 둘 운영하면 기관은 하나고 이 값만 갈린다. NOTI_BAS와 CRWL_LOG_DTL이 같은 축을 쓰므로 (AGNCY_SN, BBS_STTS_CD)로 둘을 견줄 수 있다" },
    { "logical": "원문키내용",       "physical": "SRC_KEY_CTNT",      "domain": "D_CTNT", "description": "지자체 홈페이지가 게시물을 식별하는 사람이 읽는 키 원문 — [기관번호:게시물 식별 방식:게시물 번호]. 해시는 되돌릴 수 없으므로 중복 오판을 따질 때 볼 것은 이 컬럼뿐이다" },
    { "logical": "원문키해시",       "physical": "SRC_KEY_HASH",      "domain": "D_HASH", "description": "원문키의 SHA-256 소문자 16진 64자. 같은 게시물을 두 번 담지 않게 막는 열쇠이며 UNIQUE다. 크롤 산출물이 아닌 행은 NULL이고, PostgreSQL의 UNIQUE는 NULL을 서로 다른 값으로 보므로 그런 행이 여럿 공존한다" },
    { "logical": "게시물URL",        "physical": "BBS_URL",           "domain": "D_URL",  "description": "고시공고 상세 페이지 주소. 첨부파일만 긁던 시절에는 알 길이 없던 값이고, 추출 결과를 원본과 대조할 때 유일한 통로다" },
